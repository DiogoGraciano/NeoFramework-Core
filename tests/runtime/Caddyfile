{
	# Um worker só: requisições consecutivas precisam cair no MESMO processo, que
	# é onde um vazamento entre elas apareceria. Com vários, o teste passaria por
	# sorte sempre que duas caíssem em processos diferentes.
	frankenphp {
		worker {
			file /var/www/html/tests/runtime/public/index.php
			num 1
		}
	}
	auto_https off
	admin off
}

:8080 {
	root /var/www/html/tests/runtime/public
	php_server
}
