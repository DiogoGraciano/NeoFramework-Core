{
    "name": "diogodg/neoframework",
    "description": "NeoFramework simple and fast",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NeoFramework\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests",
            "App\\": "tests/runtime/App",
            "NeoFramework\\RoadRunner\\": "packages/roadrunner/src/",
            "NeoFramework\\OpenTelemetry\\": "packages/opentelemetry/src/",
            "NeoFramework\\Image\\": "packages/image/src/",
            "NeoFramework\\BrSupport\\": "packages/br-support/src/"
        }
    },
    "authors": [
        {
            "name": "Diogo Graciano",
            "email": "138625607+DiogoGraciano@users.noreply.github.com"
        }
    ],
    "bin": [
        "bin/neof"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../NeoORM",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-exif": "*",
        "phpmailer/phpmailer": "^6.9",
        "diogodg/neoorm": "^2.0",
        "league/flysystem": "^3.29",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.8",
        "filp/whoops": "^2.17",
        "nesbot/carbon": "^3.8",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/psr7": "^2.7",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "respect/validation": "^2.4",
        "symfony/cache": "^7.4.12",
        "vlucas/phpdotenv": "^5.6",
        "adhocore/cli": "^1.9",
        "peppeocchi/php-cron-scheduler": "^4.0",
        "symfony/var-dumper": "^7.2",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.8",
        "phpstan/phpstan": "^2.1",
        "league/flysystem-aws-s3-v3": "^3.29",
        "friendsofphp/php-cs-fixer": "^3.75",
        "spiral/roadrunner-http": "^4.0",
        "spiral/roadrunner-cli": "^2.6",
        "infection/infection": "^0.35.3",
        "open-telemetry/api": "^1.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:style": "php-cs-fixer check --diff",
        "style:fix": "php-cs-fixer fix",
        "test:all": [
            "@test:style",
            "@test:types",
            "@test"
        ],
        "test:coverage": [
            "php -d pcov.enabled=1 vendor/bin/phpunit --exclude-group runtime --coverage-xml=build/coverage/coverage-xml --log-junit=build/coverage/junit.xml",
            "php bin/coverage-check.php build/coverage/coverage-xml 90"
        ],
        "test:mutation": [
            "@test:coverage",
            "infection --threads=max --coverage=build/coverage --skip-initial-tests --min-covered-msi=70"
        ]
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for the S3 disk of FileStorage",
        "league/flysystem-aws-s3-v3": "Required for the S3 disk of FileStorage"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
