<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" stopOnFailure="false" processIsolation="false" backupGlobals="false" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <testsuites>
    <testsuite name="NeoFramework Core Tests">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <!-- Test Environment Variables -->
    <env name="ENVIRONMENT" value="test"/>
    <env name="JOBS_STORAGE_PATH" value="Jobs_Test"/>
    <env name="QUEUE_DRIVER" value="files"/>
    <!-- Redis Configuration for Tests -->
    <env name="REDIS_HOST" value="redis"/>
    <env name="REDIS_PORT" value="6379"/>
    <env name="REDIS_PASSWORD" value="RedisPass"/>
    <!-- Database Configuration for Tests -->
    <env name="DRIVER" value="pgsql"/>
    <env name="DBHOST" value="postgres"/>
    <env name="DBPORT" value="5432"/>
    <env name="DBNAME" value="neoorm_test"/>
    <env name="DBCHARSET" value="utf8mb4"/>
    <env name="DBUSER" value="postgres"/>
    <env name="DBPASSWORD" value="postgres"/>
    <!-- Model Configuration for Tests -->
    <env name="PATH_MODEL" value="./tests/app/models"/>
    <env name="MODEL_NAMESPACE" value="Tests\App\Models"/>
    <!-- Cache Configuration for Tests -->
    <env name="CACHE_ADAPTER" value="filesystem"/>
    <!-- Runtimes persistentes: a suíte da §18 mede o processo real servindo -->
    <env name="FRANKENPHP_URL" value="http://frankenphp:8080"/>
    <env name="ROADRUNNER_URL" value="http://roadrunner:8081"/>
    <env name="SWOOLE_URL" value="http://swoole:8082"/>
    <env name="FPM_URL" value="http://nginx:8080"/>
    <!-- S3 (MinIO) para o contract test dos discos -->
    <env name="AWS_ENDPOINT" value="http://minio:9000"/>
    <env name="AWS_BUCKETNAME" value="neoframework-test"/>
    <env name="AWS_REGION" value="us-east-1"/>
    <env name="AWS_KEY" value="minioadmin"/>
    <env name="AWS_SECRET" value="minioadmin"/>
    <!-- CORS Configuration for Tests -->
    <env name="CORS_ENABLED" value="false"/>
    <env name="CORS_ORIGINS" value="*"/>
    <env name="CORS_METHODS" value="GET,POST,PUT,DELETE,OPTIONS"/>
    <env name="CORS_HEADERS" value="Content-Type,Authorization,X-Requested-With"/>
    <ini name="memory_limit" value="1G"/>
  </php>
  <logging>
    <junit outputFile="tests-junit.xml"/>
  </logging>
  <source>
    <include>
      <!-- Código 2.x mantido e publicado. Fachadas legadas fora desta lista
           continuam na suíte funcional, mas não diluem o gate de qualidade do
           kernel novo enquanto aguardam remoção na 3.0. -->
      <directory suffix=".php">src/Auth</directory>
      <directory suffix=".php">src/Config</directory>
      <directory suffix=".php">src/Debug</directory>
      <directory suffix=".php">src/Events</directory>
      <directory suffix=".php">src/Http</directory>
      <directory suffix=".php">src/Observability</directory>
      <directory suffix=".php">src/RateLimit</directory>
      <directory suffix=".php">src/Routing</directory>
      <directory suffix=".php">src/Storage</directory>
      <directory suffix=".php">src/Support</directory>
      <directory suffix=".php">src/Template</directory>
      <directory suffix=".php">src/Validation</directory>
      <directory suffix=".php">src/Vite</directory>
    </include>
  </source>
</phpunit>
